# Transport
MCP_TRANSPORT=http               # http | stdio
MCP_SERVER_PORT=3001
MCP_ALLOWED_ORIGINS=http://localhost:3000

# Auth
# Format: comma-separated `key:role[:option=value...]`
#   Roles: metadata_only | reader_restricted | reader | admin
#   Options:
#     set_role=<warehouse_role>  Issue SET ROLE on Postgres/Redshift before running
#                                queries — lets warehouse-side RLS / CLS / masking
#                                policies enforce per-MCP-key access.
# Examples:
#   abc123:reader
#   abc123:reader:set_role=alice_finance
#   abc123:reader_restricted,def456:admin
MCP_API_KEYS=
MCP_OIDC_ISSUER=                 # optional; if set, JWTs accepted via JWKS
MCP_OIDC_AUDIENCE=

# Warehouse selection
WAREHOUSE_TYPE=                  # postgres | oracle | redshift | snowflake | bigquery | duckdb

# Postgres
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SSL=true

# Oracle (Thin mode — no Instant Client required)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=           # e.g. "host:1521/SERVICE_NAME" or full TNS descriptor
ORACLE_WALLET_LOCATION=          # optional, for Autonomous DB / mTLS
ORACLE_WALLET_PASSWORD=

# Redshift (Postgres wire-compatible; uses the same pg driver)
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_SSL=true

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# BigQuery
GOOGLE_APPLICATION_CREDENTIALS=  # path to service account JSON
BIGQUERY_PROJECT=
BIGQUERY_LOCATION=US

# DuckDB (local/demo) — also used as a thin client for MotherDuck cloud.
# Path forms:
#   :memory:           ephemeral
#   ./demo.duckdb      local file
#   md:my_db           MotherDuck-hosted database (requires MOTHERDUCK_TOKEN)
DUCKDB_PATH=./demo.duckdb
# Required only when DUCKDB_PATH starts with md:. From MotherDuck UI -> Tokens.
MOTHERDUCK_TOKEN=

# Tenancy (multi-tenant-ready; v1 self-hosted defaults to "default")
TENANT_ID=default

# Safety
QUERY_DEFAULT_LIMIT=1000
QUERY_HARD_MAX_LIMIT=10000
QUERY_TIMEOUT_MS=30000
# Hard cap on cells (rows × columns) returned to a single tool call.
# Default 100k = e.g. 1000 rows × 100 cols. Set 0 to disable.
QUERY_MAX_RESULT_CELLS=100000
# Per-principal token-bucket rate limit on tool invocations.
# Default 0 = disabled. 60 = one tool call per second on average.
MCP_RATE_LIMIT_RPM=0

# Audit
AUDIT_DIR=./audit
AUDIT_ROTATION=daily
# Per-field clip on the audit log (sql, error). Prevents disk fill from
# unbounded driver errors or oversized SQL bodies.
AUDIT_FIELD_MAX_BYTES=4096

# Guardrails (all opt-in)
# GUARDRAIL_PII_MASK=on    Mask emails/SSNs/CCs/phones/IPs in result rows.
#                          Off: rows pass through unchanged (admin-equivalent).
#                          On: masking level depends on the caller's MCP role
#                              admin              -> unmasked
#                              reader             -> partial (a***@example.com)
#                              reader_restricted  -> full ([REDACTED:email])
#                              metadata_only      -> no rows are returned anyway
GUARDRAIL_PII_MASK=

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
