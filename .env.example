# Transport
MCP_TRANSPORT=http               # http | stdio
MCP_SERVER_PORT=3001
MCP_ALLOWED_ORIGINS=http://localhost:3000

# Auth
MCP_API_KEYS=                    # comma-separated key:role pairs, e.g. abc123:reader,def456:admin
MCP_OIDC_ISSUER=                 # optional; if set, JWTs accepted via JWKS
MCP_OIDC_AUDIENCE=

# Warehouse selection
WAREHOUSE_TYPE=                  # postgres | oracle | redshift | snowflake | bigquery | duckdb

# Postgres
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SSL=true

# Oracle (Thin mode — no Instant Client required)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=           # e.g. "host:1521/SERVICE_NAME" or full TNS descriptor
ORACLE_WALLET_LOCATION=          # optional, for Autonomous DB / mTLS
ORACLE_WALLET_PASSWORD=

# Redshift (Postgres wire-compatible; uses the same pg driver)
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_SSL=true

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# BigQuery
GOOGLE_APPLICATION_CREDENTIALS=  # path to service account JSON
BIGQUERY_PROJECT=
BIGQUERY_LOCATION=US

# DuckDB (local/demo)
DUCKDB_PATH=./demo.duckdb

# Tenancy (multi-tenant-ready; v1 self-hosted defaults to "default")
TENANT_ID=default

# Safety
QUERY_DEFAULT_LIMIT=1000
QUERY_HARD_MAX_LIMIT=10000
QUERY_TIMEOUT_MS=30000

# Audit
AUDIT_DIR=./audit
AUDIT_ROTATION=daily

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
