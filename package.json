{
  "name": "warehouse-mcp",
  "version": "0.3.2",
  "description": "Production MCP server for your data warehouse. Read-only enforcement, role-based access, audit log. Postgres, Oracle, Snowflake, BigQuery, Redshift, DuckDB, MotherDuck.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "warehouse-mcp": "bin/warehouse-mcp.js"
  },
  "files": [
    "src",
    "bin",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run --passWithNoTests --exclude '**/node_modules/**' --exclude 'test/integration/**'",
    "test:watch": "vitest --exclude '**/node_modules/**' --exclude 'test/integration/**'",
    "test:integration": "vitest run --passWithNoTests --testTimeout=120000 test/integration",
    "lint": "eslint src bin",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "oracle",
    "snowflake",
    "bigquery",
    "redshift",
    "duckdb",
    "motherduck",
    "data-warehouse",
    "claude",
    "anthropic",
    "ai",
    "llm-tools"
  ],
  "homepage": "https://github.com/kalehdoo/warehouse-mcp#readme",
  "bugs": {
    "url": "https://github.com/kalehdoo/warehouse-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalehdoo/warehouse-mcp.git"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "cors": "^2.0.0",
    "dotenv": "^16.4.5",
    "duckdb": "^1.0.0",
    "express": "^4.0.0",
    "helmet": "^7.0.0",
    "jose": "^5.0.0",
    "oracledb": "^6.0.0",
    "pg": "^8.13.0",
    "snowflake-sdk": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "testcontainers": "^10.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
